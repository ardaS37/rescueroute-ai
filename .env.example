# Copy to .env locally. Never commit this file.
RAPIDAPI_KEY=
RAPIDAPI_HOST=network-as-code.nokia.rapidapi.com
NAC_LIVE_ENABLED=false
NAC_APPLICATION_SERVER_IP=1.1.1.1
NAC_WEBHOOK_BASE_URL=https://tech-mate.tech
NAC_WEBHOOK_TOKEN=replace-with-a-random-secret
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# Accept Nokia simulator callbacks that arrive without the sink credential.
# Leave this off: it disables authentication on a public webhook that changes
# incident state.
NAC_SIMULATOR_ALLOW_UNSIGNED_CALLBACKS=false

# Access gate. Set a code to put the whole demo behind a sign-in page; the
# session it issues is also the key to the visitor's own isolated simulation.
# Leave it empty for an open deployment where everyone shares one simulation.
RESCUEROUTE_ACCESS_CODE=
# Keeps sessions valid across restarts. Rotating the access code invalidates
# every existing session regardless.
RESCUEROUTE_SESSION_SECRET=
RESCUEROUTE_MAX_WORKSPACES=40
RESCUEROUTE_WORKSPACE_TTL_SECONDS=21600

# Write-path protection. Leave the token empty for an open public demo; set it
# to lock every state-changing endpoint behind "Authorization: Bearer <token>".
RESCUEROUTE_API_TOKEN=
RESCUEROUTE_RATE_LIMIT_ENABLED=true
RESCUEROUTE_WRITE_PER_MINUTE=60
RESCUEROUTE_WRITE_BURST=20
RESCUEROUTE_DISPATCH_PER_MINUTE=30
RESCUEROUTE_DISPATCH_BURST=15
RESCUEROUTE_MAX_INCIDENTS=500
