{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "none",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noFallthroughCasesInSwitch": true,
    "newLine": "lf",
    "rootDir": "src",
    "outDir": "frontend"
  },
  "include": ["src/**/*.ts"]
}
